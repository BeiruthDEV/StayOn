<?xml version="1.0" encoding="utf-8"?>
<!--
  Só o evento de troca de janela interessa, e o serviço não pede permissão
  para ler o conteúdo da tela: o nome do pacote que abriu já vem no evento e é
  tudo de que o bloqueio precisa.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagDefault"
  android:canPerformGestures="false"
  android:canRetrieveWindowContent="false"
  android:notificationTimeout="100"
  android:description="@string/stay_on_blocker_description" />
